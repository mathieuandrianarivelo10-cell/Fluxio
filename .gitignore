firebase.json

# 2. Clés de Signature & Keystores
*.jks
*.keystore
debug.keystore
debug.keystore.base64
*.pepk
*.p12
*.pem
*.key
*.crt
*.der

# 3. Gradle & Répertoires de Build
.gradle/
build/
app/build/
**/build/
.kotlin/
.build-outputs/
bin/
gen/
out/
tmp/

